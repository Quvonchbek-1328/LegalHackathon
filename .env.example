# Nusxa oling: cp .env.example .env
PORT=3000

# AI tahlil (bo‘sh bo‘lsa — namuna rejim)
ANTHROPIC_API_KEY=
LC_MODEL=claude-sonnet-4-5

# Telegram Mini App
TELEGRAM_BOT_TOKEN=
# HTTPS manzil; berilsa bot menyusiga Mini App tugmasi qo‘yiladi
PUBLIC_URL=
# 1 bo‘lsa, API faqat Telegram ichidan ishlaydi
REQUIRE_TELEGRAM=0

# Frontend boshqa domenda bo‘lsa (vergul bilan)
CORS_ORIGIN=
MAX_FILE_MB=15

# OCR tillari (tesseract): o‘zbek lotin, o‘zbek kirill, rus, ingliz
OCR_LANGS=uzb+uzb_cyrl+rus+eng

# Qo‘lyozma (HTR). O‘z serveringizdagi vision model (Ollama/vLLM, OpenAI-mos API):
# rasm serverdan chiqmaydi. Bo‘sh bo‘lsa va ANTHROPIC_API_KEY bor bo‘lsa — rozilik bilan tashqi AI.
HTR_BASE_URL=
HTR_MODEL=qwen2.5vl:7b
HTR_API_KEY=
